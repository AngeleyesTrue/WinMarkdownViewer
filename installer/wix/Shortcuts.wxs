<?xml version="1.0" encoding="utf-8"?>
<!--
  Shortcuts.wxs - 시작 메뉴 바로가기 정의
  시작 메뉴 > WinMarkdownViewer 폴더에 바로가기를 생성한다.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include Variables.wxi ?>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents" Directory="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="$(var.ProductName)"
                  Target="[INSTALLFOLDER]$(var.ExeFileName)"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.exe" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <!-- KeyPath용 레지스트리 값 (WiX 컴포넌트 규칙 준수) -->
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.ProductName)"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
